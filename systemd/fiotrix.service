[Unit]
Description=FioTrix FastAPI API (gunicorn + uvicorn workers)
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fiotrix
Group=fiotrix
WorkingDirectory=/opt/fiotrix
Environment=PATH=/opt/fiotrix/.venv/bin
EnvironmentFile=-/opt/fiotrix/.env
ExecStart=/opt/fiotrix/.venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
